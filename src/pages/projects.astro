---
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout>
  <section aria-labelledby="projects-heading" class="space-y-8">
    <div>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-subtle)]">Projects</p>
      <h1 id="projects-heading" class="text-3xl font-semibold tracking-tight text-[var(--text)] sm:text-4xl">
        Things I’ve built.
      </h1>
      <p class="mt-3 max-w-xl text-base leading-relaxed text-[var(--text-muted)]">
        A few websites, tools, and tiny systems I’ve built, maintained, or messed around with.
      </p>
    </div>

    <ol class="grid list-none gap-4 p-0 sm:grid-cols-2">
      <ProjectCard href="https://www.stjohnshikeclub.com" title="St. John's Hike Club" featured>
        Website for a hiking community in St. John&apos;s, Newfoundland.
      </ProjectCard>

      <ProjectCard href="https://github.com/AlexGaudon/tallyo" title="Tallyo" featured>
        My take on a personal finance tracker, since <Link href="https://en.wikipedia.org/wiki/Intuit_Mint#Shut_down">Mint</Link> ran out of money.
      </ProjectCard>

      <ProjectCard href="https://github.com/AlexGaudon/overs.sh" title="overs.sh">
        Super simple file transfer between servers over SSH. Dead easy.
      </ProjectCard>

      <ProjectCard href="https://misery.systems" title="misery.systems">
        Where I mess around with my homelab (yeah, it&apos;s really called &quot;misery.systems&quot;).
      </ProjectCard>

      <ProjectCard href="https://github.com/AlexGaudon/stocky" title="stocky">
        A Discord bot that spits out stock prices on command.
      </ProjectCard>

      <ProjectCard href="https://github.com/alexgaudon/ntfy-bridge" title="ntfy-bridge">
        Bridges Discord and <Link href="https://ntfy.sh">ntfy.sh</Link> so you can get notifications wherever you want.
      </ProjectCard>

      <ProjectCard href="https://github.com/alexgaudon/lootsheet" title="LootSheet">
        A simple group hunting loot splitter for Tibia.
      </ProjectCard>
    </ol>
  </section>
</Layout>
